# Bybit API credentials
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Trading mode: paper / live
TRADING_MODE=paper

# Initial deposit for paper trading (USD)
PAPER_DEPOSIT=150

# Leverage
LEVERAGE=5

# Risk per trade (fraction, e.g. 0.08 = 8%)
RISK_PER_TRADE=0.08

# Max simultaneous positions
MAX_POSITIONS=3

# Min reward:risk ratio
MIN_RR_RATIO=3.0
